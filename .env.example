# Copy to .env. Never commit credentials or paste them into Discord.
NODE_ENV=development
FIREBASE_PROJECT_ID=craftland-4a761
# Choose ONE Firebase credential method. Service account file recommended locally.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Alternative: leave path blank and use these two secure environment values.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
DISCORD_GUILD_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=
DASHBOARD_ENABLED=false
PORT=3000
DASHBOARD_URL=http://localhost:3000
SESSION_SECRET=
TIMEZONE=Asia/Kolkata
GENERAL_CHAT_CHANNEL_ID=
DOUBT_SOLVING_CHANNEL_ID=
