{
  "name": "craftland-india-ai-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc -p tsconfig.dashboard.json && vite build",
    "start": "node dist/index.js",
    "register": "tsx src/bot/register.ts",
    "invite": "tsx src/bot/invite.ts",
    "test": "vitest run",
    "lint": "eslint src tests dashboard",
    "format": "prettier --write src tests dashboard README.md",
    "check": "npm run lint && npm run build && npm test",
    "test:firestore": "vitest run tests/database.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "discord.js": "14.27.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^10.11.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^5.0.2"
  }
}
